{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docs": "npm --prefix ../docs-site run dev",
    "build": "tsc -b && vite build",
    "build:docs": "npm --prefix ../docs-site run build",
    "lint": "oxlint --deny-warnings && eslint --config eslint.adherence.config.js src --max-warnings 0 && stylelint \"src/**/*.css\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^6.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "stylelint": "^17.14.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
