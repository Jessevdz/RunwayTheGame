{
  "defaultSeverity": "error",
  "rules": {
    "color-no-hex": true,
    "declaration-property-value-disallowed-list": {
      "/^(margin|padding)(-|$)/": ["/(^|[\\s(,*/+-])-?([2-9]|[1-9]\\d+)(\\.\\d+)?px/"],
      "/^(gap|row-gap|column-gap|inset|inset-[a-z-]+|top|right|bottom|left)$/": ["/(^|[\\s(,*/+-])-?([2-9]|[1-9]\\d+)(\\.\\d+)?px/"],
      "border-radius": ["/(^|[\\s(,*/+-])-?([2-9]|[1-9]\\d+)(\\.\\d+)?px/"],
      "/^(border|outline)(-(top|right|bottom|left))?$/": ["/(^|[\\s(,*/+-])([4-9]|[1-9]\\d+)(\\.\\d+)?px/"],
      "/^(border|outline)(-(top|right|bottom|left))?-width$/": ["/(^|[\\s(,*/+-])([4-9]|[1-9]\\d+)(\\.\\d+)?px/"]
    },
    "declaration-property-value-allowed-list": {
      "font-size": ["/^(inherit|initial|unset|-?\\d*\\.?\\d+(em|%))$/", "/var\\(--[a-z0-9-]+\\)/"]
    }
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "declaration-property-value-disallowed-list": null,
        "declaration-property-value-allowed-list": null
      }
    }
  ]
}
