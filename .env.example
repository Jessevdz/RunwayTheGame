# Database
RUNWAY_DB_HOST=db
RUNWAY_DB_PORT=5432
RUNWAY_DB_USER=postgres
RUNWAY_DB_PASSWORD=
RUNWAY_DB_NAME=runway
RUNWAY_DB_SSLMODE=disable

# Object storage
# Supply matching credentials when the worker runs outside Docker Compose too.
S3_ENDPOINT=minio:9000
# Browser-facing frontend/proxy URL for evidence uploads. Keep uploads on the
# proxy path so its request-size limit applies; production deployments should
# set this to the public app origin (for example, https://race.example.com).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=runway-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
S3_PATH_STYLE=true

# Server
PORT=8080
RUNWAY_TICK_INTERVAL_SECONDS=10

# Shared secret between the server and the verification worker. 
# Generate one per deployment, e.g. `openssl rand -hex 32`.
RUNWAY_WORKER_TOKEN=

# Secret GUID required to access and manage the public roadmap admin route.
RUNWAY_ROADMAP_ADMIN_KEY=dummy

# SameSite policy for the admin session cookie: strict (default), lax, or none.
RUNWAY_ADMIN_COOKIE_SAMESITE=

# Comma-separated browser origins allowed to call the API and open the
# websocket, e.g. https://race.example.com. Leave empty for local development.
RUNWAY_ALLOWED_ORIGINS=

# Verification worker
RUNWAY_API_BASE_URL=http://server:8080
WORKER_POLL_INTERVAL_MS=500
SCALEWAY_API_KEY=
